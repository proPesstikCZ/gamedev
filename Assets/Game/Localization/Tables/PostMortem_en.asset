  m_TableData:
  - m_Id: 344641536
    m_Localized: 'Average review: {2:0.0} / 10.'
    m_Metadata:
      m_Items:
      - rid: 6476484526842052970
  - m_Id: 374001664
    m_Localized: The game beat what players expect these days.
    m_Metadata:
      m_Items: []
  - m_Id: 374001665
    m_Localized: The game met what players expect these days.
    m_Metadata:
      m_Items: []
  - m_Id: 374001666
    m_Localized: The game fell short of what players expect these days.
    m_Metadata:
      m_Items: []
  - m_Id: 374001667
    m_Localized: '{0} and {1} are an excellent match.'
    m_Metadata:
      m_Items:
      - rid: 6476484526842052970
  - m_Id: 374001668
    m_Localized: '{0} and {1} work well together.'
    m_Metadata:
      m_Items:
      - rid: 6476484526842052970
  - m_Id: 374001669
    m_Localized: '{0} and {1} do not fit together.'
    m_Metadata:
