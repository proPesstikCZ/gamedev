      - rid: 6476484526842052970
  - m_Id: 382390272
    m_Localized: '{0} did not suit the audience "{1}".'
    m_Metadata:
      m_Items:
      - rid: 6476484526842052970
  - m_Id: 382390273
    m_Localized: Players ran into a lot of bugs. More testing would help.
    m_Metadata:
      m_Items: []
  - m_Id: 382390274
    m_Localized: The game was nearly bug-free.
    m_Metadata:
