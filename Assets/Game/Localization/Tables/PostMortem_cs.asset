  m_TableData:
  - m_Id: 344641536
    m_Localized: "Pr\u016Fm\u011Brn\xE9 hodnocen\xED: {2:0.0} / 10."
    m_Metadata:
      m_Items:
      - rid: 6476484526842052968
  - m_Id: 374001664
    m_Localized: "Hra p\u0159ekonala to, co dnes hr\xE1\u010Di o\u010Dek\xE1vaj\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 374001665
    m_Localized: "Hra splnila to, co dnes hr\xE1\u010Di o\u010Dek\xE1vaj\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 374001666
    m_Localized: "Hra nedos\xE1hla na to, co dnes hr\xE1\u010Di o\u010Dek\xE1vaj\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 374001667
    m_Localized: "{0} a t\xE9ma {1} k sob\u011B skv\u011Ble pasuj\xED."
    m_Metadata:
      m_Items:
      - rid: 6476484526842052968
  - m_Id: 374001668
    m_Localized: "{0} a t\xE9ma {1} k sob\u011B pasuj\xED dob\u0159e."
    m_Metadata:
      m_Items:
      - rid: 6476484526842052968
  - m_Id: 374001669
    m_Localized: "{0} a t\xE9ma {1} k sob\u011B nepasuj\xED."
    m_Metadata:
      m_Items:
      - rid: 6476484526842052968
  - m_Id: 382390272
    m_Localized: "\u017D\xE1nr {0} se pro publikum \u201E{1}\u201C nehodil."
    m_Metadata:
      m_Items:
      - rid: 6476484526842052968
  - m_Id: 382390273
    m_Localized: "Hr\xE1\u010Di narazili na spoustu chyb. Pomohlo by del\u0161\xED testov\xE1n\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 382390274
    m_Localized: "Hra byla t\xE9m\u011B\u0159 bez chyb."
    m_Metadata:
      m_Items: []
  - m_Id: 382390275
    m_Localized: "\u017D\xE1nr {0} je te\u010F v m\xF3d\u011B, a to pomohlo."
    m_Metadata:
      m_Items:
      - rid: 6476484526842052968
  - m_Id: 382390276
    m_Localized: "\u017D\xE1nr {0} te\u010F nen\xED v m\xF3d\u011B."
    m_Metadata:
      m_Items:
      - rid: 6476484526842052968
  - m_Id: 382390277
    m_Localized: "Hr\xE1\u010Di \u017E\xE1nru {0} ocenili oblast {1}."
    m_Metadata:
      m_Items:
      - rid: 6476484526842052968
  - m_Id: 382390278
    m_Localized: "U \u017E\xE1nru {0} na oblasti {1} docela z\xE1le\u017E\xED."
    m_Metadata:
      m_Items:
      - rid: 6476484526842052968
  - m_Id: 382390279
    m_Localized: "Oblast {1} u \u017E\xE1nru {0} skoro nikoho nezaj\xEDmala."
    m_Metadata:
      m_Items:
      - rid: 6476484526842052968
  - m_Id: 382390280
    m_Localized: "Nejsiln\u011Bj\u0161\xED str\xE1nka hry: {0}."
    m_Metadata:
      m_Items:
      - rid: 6476484526842052968
  - m_Id: 382390281
    m_Localized: "Nejslab\u0161\xED str\xE1nka hry: {0}."
    m_Metadata:
      m_Items:
      - rid: 6476484526842052968
