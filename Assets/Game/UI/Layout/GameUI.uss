/* One look across all eras (STYLE 4): neutral dark panels and one accent colour. */
:root {
    --bg-panel: rgba(28, 30, 34, 0.94);
    --bg-raised: rgb(44, 47, 54);
    --bg-hover: rgb(58, 62, 71);
    --text: rgb(232, 230, 225);
    --text-dim: rgb(160, 160, 155);
    --accent: rgb(224, 160, 48);
    --accent-dark: rgb(150, 104, 24);
    --good: rgb(120, 190, 110);
    --bad: rgb(220, 95, 85);
}

.hidden {
    display: none;
}

.root {
    flex-grow: 1;
    color: var(--text);
    font-size: 15px;
}

.panel {
    background-color: var(--bg-panel);
    border-radius: 6px;
    padding: 8px 12px;
}

Label {
    white-space: normal;
    color: var(--text);
}

Button {
    background-color: var(--bg-raised);
    color: var(--text);
    border-width: 0;
    border-radius: 4px;
    padding: 4px 10px;
    margin: 2px 3px;
    -unity-font-style: bold;
}

Button:hover {
    background-color: var(--bg-hover);
}

Button:disabled {
    opacity: 0.4;
}

.accent-button {
    background-color: var(--accent);
    color: rgb(30, 24, 12);
}

.accent-button:hover {
    background-color: var(--accent-dark);
}

.selected {
    background-color: var(--accent);
    color: rgb(30, 24, 12);
}

.dim {
    color: var(--text-dim);
}

.good {
    color: var(--good);
}

.bad {
    color: var(--bad);
}

/* HUD */
.hud {
    /* A tall side panel must not squeeze the HUD; the body below gives way instead. */
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    margin: 8px;
    border-radius: 6px;
}

.hud-group {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin: 2px 8px;
}

.hud-date {
    -unity-font-style: bold;
    min-width: 220px;
    margin-right: 12px;
}

.hud-stat {
    margin-right: 16px;
}

.hud-money {
    color: var(--accent);
    -unity-font-style: bold;
}

.speed-button {
    min-width: 40px;
}

.hud-paused {
    color: var(--accent);
    margin-left: 6px;
}

.lang-button {
    min-width: 36px;
}

/* Body: free space for the studio scene, side panel on the right. */
.body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: row;
}

.main-area {
    flex-grow: 1;
    justify-content: flex-end;
}

.side-area {
    width: 380px;
    max-width: 45%;
    margin: 0 8px 8px 0;
}

.toasts {
    align-items: flex-start;
    margin: 8px;
}

.toast {
    background-color: var(--bg-panel);
    border-left-width: 4px;
    border-left-color: var(--accent);
    border-radius: 4px;
    padding: 6px 10px;
    margin-top: 4px;
    max-width: 520px;
}

/* Dialogs */
.modal-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.modal {
    width: 70%;
    max-width: 900px;
    max-height: 90%;
    padding: 16px 20px;
}

.modal-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--accent);
    margin-bottom: 10px;
}

.section-title {
    font-size: 17px;
    -unity-font-style: bold;
    margin-top: 10px;
    margin-bottom: 4px;
}

.button-row {
    flex-direction: row;
    justify-content: flex-end;
    flex-wrap: wrap;
    margin-top: 12px;
}

.modal-host {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    justify-content: center;
}

.modal-scroll {
    flex-shrink: 1;
}

.form-field {
    margin: 3px 0;
}

.form-field > Label {
    min-width: 140px;
    color: var(--text-dim);
}

.info-box {
    background-color: var(--bg-raised);
    border-radius: 4px;
    padding: 8px 10px;
    margin-top: 8px;
}

.strong {
    -unity-font-style: bold;
}

.error-list > Label {
    color: var(--bad);
    margin-top: 4px;
}

/* Input fields in the dark look. */
.unity-base-field__input {
    background-color: var(--bg-raised);
    border-color: var(--bg-hover);
    color: var(--text);
}

.unity-base-field__input:hover {
    background-color: var(--bg-hover);
}

.unity-base-field__input > Label,
.unity-base-field__input TextElement {
    color: var(--text);
}

.unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--text);
}

.unity-base-slider__tracker {
    background-color: var(--bg-hover);
    border-color: var(--bg-hover);
}

.unity-base-slider__dragger {
    background-color: var(--accent);
    border-color: var(--accent-dark);
}

/* Development panel */
.side-host {
    flex-grow: 1;
}

.dev-panel {
    flex-grow: 1;
}

/* Only the scroll part of the panel shrinks; the header keeps its height. */
.dev-panel > Label,
.dev-panel > .dev-progress {
    flex-shrink: 0;
}

.dev-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.dev-progress {
    margin: 6px 0;
}

.dev-progress .unity-progress-bar__progress {
    background-color: var(--accent);
}

.dev-progress .unity-progress-bar__background {
    background-color: var(--bg-raised);
    /* The default bar is shorter than one line of our text, so the title spilled out. */
    min-height: 24px;
}

.dev-progress .unity-progress-bar__title {
    font-size: 13px;
}

.dev-phase {
    background-color: var(--bg-raised);
    border-radius: 4px;
    padding: 6px 8px;
    margin-top: 6px;
    border-left-width: 3px;
    border-left-color: var(--bg-raised);
}

.dev-phase.current {
    border-left-color: var(--accent);
}

.dev-area {
    flex-direction: row;
    align-items: center;
}

.dev-area-name {
    width: 38%;
    font-size: 13px;
}

.dev-area-weight {
    width: 34px;
    font-size: 11px;
    color: var(--accent);
}

.dev-area-slider {
    flex-grow: 1;
    margin: 0 4px;
}

.dev-area-value {
    width: 40px;
    -unity-text-align: middle-right;
    font-size: 13px;
}

.small {
    font-size: 12px;
}

/* Results, games list, encyclopedia */
.results-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.results-heading {
    flex-shrink: 1;
}

.results-review {
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--accent);
    margin-left: 16px;
}

.results-columns {
    flex-direction: row;
    flex-wrap: wrap;
}

.results-column {
    flex-grow: 1;
    flex-basis: 300px;
    margin-right: 12px;
}

.postmortem > Label {
    margin-bottom: 4px;
    padding-left: 8px;
    border-left-width: 2px;
    border-left-color: var(--accent-dark);
}

.chart {
    flex-direction: row;
    align-items: flex-end;
    height: 110px;
    background-color: var(--bg-raised);
    border-radius: 4px;
    padding: 6px;
}

.chart-bar {
    flex-grow: 1;
    margin: 0 1px;
    background-color: var(--accent);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
}

.game-row {
    -unity-text-align: middle-left;
    white-space: normal;
    padding: 6px 10px;
    margin: 2px 0;
}

.row-line {
    flex-direction: row;
    justify-content: space-between;
    margin: 1px 0;
}

.row-line > Label {
    flex-shrink: 1;
}

.bankrupt {
    max-width: 560px;
}

.accent-text {
    color: var(--accent);
    margin-left: 8px;
}

/* Red wins over the accent colour of titles and money. */
.modal-title.bad,
.hud-money.bad {
    color: var(--bad);
}
